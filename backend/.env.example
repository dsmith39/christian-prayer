PORT=5000
DYNAMODB_TABLE_NAME=faithrequest-users
AWS_REGION=us-east-1
CLIENT_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
JWT_SECRET=change_this_secret

# Production (Lambda): JWT_SECRET is NOT set directly. Instead set
# JWT_SECRET_ARN to a Secrets Manager secret ARN and leave JWT_SECRET unset -
# lambda.js resolves it at cold start. AWS_REGION is provided automatically
# by the Lambda runtime and should not be set manually there.
#
# JWT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:<account-id>:secret:faithrequest/prod/jwt-secret
# CLIENT_ORIGIN=https://faithrequest.com,https://www.faithrequest.com
