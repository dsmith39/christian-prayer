AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=prayer-keep-api
IMAGE_TAG=latest

ECS_TASK_FAMILY=prayer-keep-api
ECS_CONTAINER_NAME=prayer-keep-api
ECS_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/ecsTaskExecutionRole
ECS_TASK_ROLE_ARN=arn:aws:iam::123456789012:role/prayer-keep-task-role
ECS_CPU=256
ECS_MEMORY=512
CONTAINER_PORT=5000
LOG_GROUP=/ecs/prayer-keep-api
LOG_STREAM_PREFIX=ecs

API_BASE_URL=https://api.your-domain.com/api
CLIENT_ORIGIN=https://app.your-domain.com
MONGODB_URI_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:prayer-keep/prod/MONGODB_URI
JWT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:prayer-keep/prod/JWT_SECRET

FRONTEND_S3_BUCKET=prayer-keep-web-prod
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
ECS_CLUSTER=prayer-keep-prod
ECS_SERVICE=prayer-keep-api