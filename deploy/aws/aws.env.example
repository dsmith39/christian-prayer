AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=faithrequest-api
IMAGE_TAG=latest

ECS_TASK_FAMILY=faithrequest-api
ECS_CONTAINER_NAME=faithrequest-api
ECS_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/ecsTaskExecutionRole
ECS_TASK_ROLE_ARN=arn:aws:iam::123456789012:role/faithrequest-task-role
ECS_CPU=256
ECS_MEMORY=512
CONTAINER_PORT=5000
LOG_GROUP=/ecs/faithrequest-api
LOG_STREAM_PREFIX=ecs

API_BASE_URL=https://api.faithrequest.com/api
CLIENT_ORIGIN=https://faithrequest.com
MONGODB_URI_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:faithrequest/prod/MONGODB_URI
JWT_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:faithrequest/prod/JWT_SECRET

FRONTEND_S3_BUCKET=faithrequest-web-prod
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC
ECS_CLUSTER=faithrequest-prod
ECS_SERVICE=faithrequest-api